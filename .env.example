# =============================================================================
# GLAMEA BACKEND — Production Environment Configuration
# =============================================================================
# Copy to .env and fill in ALL values before deploying.
# Lines marked [REQUIRED] will cause the server to refuse to start if empty.
# Lines marked [OPTIONAL] degrade gracefully when empty (feature disabled).

APP_ENV=production
APP_NAME=glamea-backend
HTTP_ADDR=:8080

# -----------------------------------------------------------------------------
# [REQUIRED] Database — MySQL / TiDB Cloud connection string
# Format: mysql://USER:PASS@HOST:PORT/DB?parseTime=true&multiStatements=true&tls=true
# -----------------------------------------------------------------------------
DATABASE_URL=

# [OPTIONAL] MongoDB — only needed if feed features use it
# MONGODB_URI=mongodb://user:pass@host:27017
# MONGODB_NAME=glamea

# [REQUIRED] Redis — used for rate limiting, slot locking, caching
# Format: rediss://default:PASSWORD@HOST:PORT/0  (TLS)
#         redis://default:PASSWORD@HOST:PORT/0   (no TLS)
REDIS_URL=

# -----------------------------------------------------------------------------
# [REQUIRED] Auth
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m

# -----------------------------------------------------------------------------
# Booking / Payouts
# -----------------------------------------------------------------------------
BOOKING_SLOT_LOCK_TTL=10m
IDEMPOTENCY_KEY_TTL=24h
PAYOUT_HOLDING_PERIOD=168h

# -----------------------------------------------------------------------------
# [REQUIRED] CORS — comma-separated list of allowed origins
# Include your production domain, admin panel URL, and any staging URLs.
# Example: https://glamea.com,https://admin.glamea.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Media Storage — Cloudinary (recommended for production)
# When empty, files are stored locally in LOCAL_MEDIA_DIR (not suitable for prod).
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=glamea
LOCAL_MEDIA_DIR=./uploads

# -----------------------------------------------------------------------------
# [OPTIONAL] Push Notifications — Firebase Cloud Messaging
# Leave blank to disable push notifications (in-app notifications still work).
# FCM_SERVICE_ACCOUNT_FILE is the path to the service-account JSON file.
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# -----------------------------------------------------------------------------
# [REQUIRED] Payment Gateway — configure at least one provider
# SeerBit: https://dashboard.seerbitapi.com
# Paystack: https://dashboard.paystack.com
# Flutterwave: https://dashboard.flutterwave.com
#
# The first provider with valid keys becomes the primary gateway.
# Keys starting with SBTEST/sk_test are treated as test/sandbox keys.
# -----------------------------------------------------------------------------
# SeerBit (primary — configure for Nigerian payments)
SEERBIT_SECRET_KEY=
SEERBIT_PUBLIC_KEY=
SEERBIT_BASE_URL=https://seerbitapi.com/api/v2

# Paystack (alternative)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Flutterwave (alternative)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# -----------------------------------------------------------------------------
# [REQUIRED] Public API URL — used for payment callbacks and media URLs
# Must be the publicly accessible URL of this backend.
# Example: https://api.glamea.com
# -----------------------------------------------------------------------------
APP_URL=

# -----------------------------------------------------------------------------
# [OPTIONAL] Google Maps — for location picker, discovery map, directions
# Without this, location features use approximate positioning only.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# [OPTIONAL] WebRTC TURN relay — for reliable voice/video calls behind NATs
# Without this, calls may fail on strict firewalls (symmetric NAT).
# Recommended provider: https://www.metered.ca/tools/openrelay/
# -----------------------------------------------------------------------------
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# [OPTIONAL] Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
POSTHOG_API_KEY=

# -----------------------------------------------------------------------------
# [OPTIONAL] Clerk Authentication
# Used for OAuth sign-in (Google, Apple) and session management.
# Get keys from https://dashboard.clerk.com
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_APP_ID=

# -----------------------------------------------------------------------------
# [OPTIONAL] Resend — Email delivery for OTP / verification codes
# Without this, verification codes are logged but not emailed.
# Get key from https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Platform Fees
# -----------------------------------------------------------------------------
PLATFORM_FEE_PERCENT=8.0
DEFAULT_CURRENCY=NGN
